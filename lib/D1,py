import json
import re

import requests
from Crypto.Cipher import AES
from Crypto.Util.Padding import unpad
from base.spider import Spider as BaseSpider


class Spider(BaseSpider):
    def init(self, extend=""):
        self.key = (extend or "").strip()

    def getName(self):
        return "Decrypt"

    def liveContent(self, url):
        if not url:
            raise ValueError("missing cipher url")
        text = self._read_text(url)
        return self._decrypt_text(text, self.key)

    def localProxy(self, param):
        try:
            if isinstance(param, dict):
                query = dict(param)
                url = query.get("url") or query.get("u") or query.get("src")
                key = query.get("key") or query.get("ext") or self.key
            elif isinstance(param, str):
                url = param
                key = self.key
            else:
                url = None
                key = self.key

            if not url:
                return [400, "text/plain; charset=utf-8", "decrypt: missing url"]
            if not key:
                return [400, "text/plain; charset=utf-8", "decrypt: missing key"]

            content = self._decrypt_text(self._read_text(url), key)
            return [200, "text/plain; charset=utf-8", content]

        except Exception as error:
            return [502, "text/plain; charset=utf-8", "decrypt: " + str(error)]

    @staticmethod
    def _read_text(url):
        if not url:
            raise ValueError("missing url")
        url = str(url).strip()
        if re.match(r"^https?://", url, re.IGNORECASE):
            response = requests.get(
                url,
                timeout=20,
                headers={"User-Agent": "Mozilla/5.0"},
            )
            response.raise_for_status()
            return response.text
        return url

    @staticmethod
    def _sanitize(text):
        if not text:
            return ""
        return re.sub(r"(?m)^//.*$", "", str(text)).strip()

    @staticmethod
    def _is_hex(text):
        return bool(re.fullmatch(r"[0-9a-fA-F]+", text)) and len(text) % 2 == 0

    @staticmethod
    def _try_json(value):
        try:
            obj = json.loads(value)
            if isinstance(obj, str):
                return obj
            return json.dumps(obj, ensure_ascii=False, indent=2)
        except Exception:
            return None

    def _decrypt_text(self, text, key):
        source = self._sanitize(text)
        if not source:
            return source

        parsed = self._try_json(source)
        if parsed is not None:
            return parsed

        if not self._is_hex(source):
            raise ValueError("Content is neither JSON nor TVBox hex data")

        marker = source.lower().find("2324")
        if marker < 0:
            raise ValueError("TVBox header was not found")

        header_end = marker + 4
        iv_hex = source[-26:]
        cipher_hex = source[header_end:-26]

        prefix_bytes = bytes.fromhex(source[:header_end])
        real_key = prefix_bytes.decode("utf-8", errors="replace")[2:-2]

        real_iv = bytes.fromhex(iv_hex).decode("utf-8", errors="replace")

        key_bytes = real_key.encode("utf-8")
        iv_bytes = real_iv.encode("utf-8")[:16].ljust(16, b"\x00")
        cipher_bytes = bytes.fromhex(cipher_hex)

        try:
            plain = AES.new(key_bytes, AES.MODE_CBC, iv_bytes).decrypt(cipher_bytes)
            plain = unpad(plain, 16)
        except ValueError:
            plain = AES.new(key_bytes, AES.MODE_CBC, iv_bytes).decrypt(cipher_bytes)

        decoded = plain.decode("utf-8", errors="replace")
        pretty = self._try_json(decoded)
        return pretty if pretty is not None else decoded
